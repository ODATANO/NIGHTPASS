<mvc:View
  controllerName="producer.controller.Producer"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m">
  <Page title="Battery Passports" showNavButton="false">
    <headerContent>
      <!-- Signing-facade warmth (server mode): syncing vs. at chain tip. -->
      <ObjectStatus
        text="{= ${session>/warmth/state} === 'warming' ? 'wallet syncing (' + (${session>/warmth/sinceSeconds} || 0) + 's)…' : ${session>/warmth/state} === 'ready' ? 'wallet at chain tip' : 'wallet sync error' }"
        state="{= ${session>/warmth/state} === 'ready' ? 'Success' : ${session>/warmth/state} === 'error' ? 'Error' : 'Warning' }"
        icon="{= ${session>/warmth/state} === 'ready' ? 'sap-icon://connected' : 'sap-icon://synchronize' }"
        tooltip="{session>/warmth/error}"
        visible="{= ${session>/mode} === 'server' &amp;&amp; !!${session>/warmth/state} }"
        class="sapUiTinyMarginEnd"/>
      <ObjectStatus
        text="{= (${session>/mode} === 'server' ? 'server wallet: ' : 'wallet: ') + ${session>/signerLabel} + ' · ' + ${session>/ownerShort} }"
        state="Success" visible="{session>/connected}"
        icon="{= ${session>/mode} === 'server' ? 'sap-icon://it-host' : 'sap-icon://wallet' }"/>
      <Button text="Switch wallet" icon="sap-icon://journey-change" press="onSwitchWallet" visible="{session>/connected}"/>
      <Button text="Create passport" type="Emphasized" icon="sap-icon://add" press="onCreate" enabled="{session>/connected}"/>
      <Button text="Register partner" icon="sap-icon://add-employee" press="onRegisterPartner"/>
      <Button icon="sap-icon://refresh" tooltip="Refresh" press="onRefresh"/>
    </headerContent>
    <content>
      <Table id="passportTable" items="{path: '/Passports', parameters: {'$count': true}}" growing="true" growingThreshold="50"
             mode="None" itemPress="onOpen" visible="{session>/connected}">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="{= 'Passports (' + (${session>/passportCount} || 0) + ')' }"/>
            <ToolbarSpacer/>
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="Passport ID"/></Column>
          <Column><Text text="Model"/></Column>
          <Column demandPopin="true" minScreenWidth="Tablet"><Text text="Category"/></Column>
          <Column><Text text="Status"/></Column>
          <Column demandPopin="true" minScreenWidth="Desktop"><Text text="Attestation tx"/></Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation">
            <cells>
              <ObjectIdentifier title="{passportId}" text="{manufacturerId}"/>
              <Text text="{model}"/>
              <Text text="{batteryCategory}"/>
              <ObjectStatus text="{status}"
                state="{= ${status} === 'anchored' ? 'Success' : ${status} === 'failed' ? 'Error' : ${status} === 'anchoring' ? 'Warning' : 'None' }"/>
              <Link text="{= ${attestationTxHash} ? ${attestationTxHash} : 'not anchored' }"
                    href="{parts: ['attestationTxHash', 'anchorNetwork'], formatter: '.explorerTx'}"
                    target="_blank" enabled="{= !!${attestationTxHash} }"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>

      <Panel expandable="true" expanded="true" class="sapUiMediumMarginTop">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="S/4HANA goods receipts"/>
            <ToolbarSpacer/>
            <Button text="Fetch from S/4" icon="sap-icon://synchronize" press="onS4Fetch" enabled="{= !${s4>/busy} }"/>
          </OverflowToolbar>
        </headerToolbar>
        <Table id="s4Table" items="{s4>/rows}" noDataText="Nothing fetched yet. 'Fetch from S/4' pulls the latest goods receipts from the connected system.">
          <columns>
            <Column><Text text="Document"/></Column>
            <Column><Text text="Material"/></Column>
            <Column demandPopin="true" minScreenWidth="Tablet"><Text text="Posted"/></Column>
            <Column demandPopin="true" minScreenWidth="Tablet"><Text text="Maps to"/></Column>
            <Column><Text text="Status"/></Column>
            <Column hAlign="End"><Text text=""/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <ObjectIdentifier title="{s4>docKey}"/>
                <Text text="{s4>material}"/>
                <Text text="{s4>postingDate}"/>
                <ObjectIdentifier title="{s4>model}" text="{s4>batteryCategory}"/>
                <ObjectStatus
                  text="{= ${s4>status} === 'ready' ? 'ready' : ${s4>status} === 'exists' ? 'passport exists' : 'not a battery' }"
                  state="{= ${s4>status} === 'ready' ? 'Success' : ${s4>status} === 'exists' ? 'Information' : 'None' }"/>
                <Button text="Create passport" type="Emphasized" icon="sap-icon://add"
                        press="onS4Create" visible="{= ${s4>status} === 'ready' }"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>

      <Panel headerText="Registered dataspace partners" expandable="true" expanded="true" class="sapUiMediumMarginTop">
        <Table id="partnersTable" items="{/Partners}">
          <columns>
            <Column><Text text="Name"/></Column>
            <Column><Text text="Role"/></Column>
            <Column demandPopin="true" minScreenWidth="Tablet"><Text text="DID / BPN"/></Column>
            <Column demandPopin="true" minScreenWidth="Desktop"><Text text="granteeId"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <ObjectIdentifier title="{name}"/>
                <ObjectStatus text="{role}" state="{= ${role} === 'authority' ? 'Warning' : 'Information' }"/>
                <Text text="{did}"/>
                <Text text="{granteeId}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </content>
  </Page>
</mvc:View>
