# Compose and Caddy config. Copy to deploy/.env and fill in; never commit it.
# The app itself reads deploy/.env.demo (see .env.demo.example).

# Main domain, opens on the explorer. The A record must point at the server
# before the first start, so Caddy can get the certificate.
DEMO_DOMAIN=passport.example.org

# Demo subdomain, opens on the demo.
TRY_DOMAIN=demo.passport.example.org

# Password of the private database container. Use a high-entropy value.
POSTGRES_PASSWORD=
