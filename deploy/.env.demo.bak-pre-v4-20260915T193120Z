# REGISTRAR (0.10.x ownership pre-registration): the wallet that DEPLOYED the
# vault above. Its attester identity is locked in as the vault's registrar,
# so the demo's "Register passport ownership" step must sign with it. This is
# the legacy/default pair (Main). NOTE: the viewing key MUST be the account-0
# encryptionPublicKey deriveWalletInfo returns for the mnemonic; NIGHTGATE
# 0.10.1 rejects a mismatched pair fail-closed.
PRODUCER_WALLET_MNEMONIC=prepare school involve attitude loyal artist blind innocent chef marine chuckle moment minute mushroom uncover velvet conduct minor huge dinner tribe print gentle love
PRODUCER_VIEWING_KEY=dea6f501196a62e2f03ec7e675b831dcdba2c6dc9d8b51bc8dca8823085b5372
PASSPORT_REGISTRAR_WALLET=default
DEMO_REGISTER_OWNERSHIP=true

# Fee sponsoring pool: visitor runs lease one member each, giving both
# FAILOVER (rotate the lead sponsor by reordering this list, no downtime)
# and PARALLELISM (up to pool-size concurrent runs). DEMO_CONCURRENCY > 1
# requires @odatano/nightgate >= 0.8.2 (hardened persist sink); load-tested
# green at 3. Fresh visitor wallets skip their chain sync entirely.
# CAUTION: NIGHTGATE's registerPassport rate limit is 30/h per registrar
# session; with sustained 3-way parallelism that bounds ~30 runs/hour.
# Remote transport: each run builds in its own worker thread; the shared
# proof server is the bound, 3 is the sweet spot.
PASSPORT_FEE_SPONSOR_WALLET=S1,S2,S3,default
DEMO_CONCURRENCY=3
NIGHTGATE_SPONSORED_CALLER_SYNC=skip
NIGHTGATE_SIGNING_KEY_RATE_LIMIT=1000

# Demo surface + service switches. 'demo,explorer' serves the demo AND this
# instance's own passport explorer (the done view links /explorer/#/p/<id>
# with live on-chain verification).
DEMO_ENABLED=true
PASSPORT_PUBLIC_SURFACE=demo,explorer
# Behind Caddy: resolve the visitor IP from X-Forwarded-For, otherwise every
# visitor shares one per-IP cap bucket.
PASSPORT_TRUST_PROXY=true
# DEMO_MAX_PER_DAY=50
# DEMO_MAX_PER_IP_PER_DAY=3
# Comma list of IPs exempt from the per-IP cap (maintainer smoke tests).
# DEMO_IP_ALLOWLIST=
# DEMO_MAX_PER_TESTER=1
# DEMO_MAX_QUEUE=5

# Publishing to zkpassport.eu is OFF for the preprod demo: that explorer is a
# PREVIEW instance, and this host serves its own preprod explorer instead.
PASSPORT_PUBLISH_URL=

# Shown in QR urls of demo passports (the demo host itself).
PASSPORT_DEMO_HOST=https://zkpassport.eu

# Ingest gate for seeding this instance's explorer with example passports.
PASSPORT_INGEST_SECRET=d2348c21fc5cdbf59817ab91e34a5d2ba139dff657587987

# Postgres pool sizing: 4 pool sponsors save multi-MB sync blobs concurrently
# at boot; the CAP default pool + 1s acquire timeout starves under that.
cds_requires_db_pool_max=20
cds_requires_db_pool_acquireTimeoutMillis=10000

# Status surfaces poll balances every few seconds; bound the 0.10.2 wallet
# read gate tightly so a warming facade answers 503 WALLET_SYNCING fast
# instead of stacking 10s waits per wallet.
NIGHTGATE_WALLET_READ_SYNC_TIMEOUT_MS=2000

