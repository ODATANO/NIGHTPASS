# "Try it" demo instance config. Copy to deploy/.env.demo and fill in.
# UNLIKE the main instance this one HOLDS WALLET SECRETS (the fee-sponsor pool
# and the registrar) and anchors visitor passports on PREPROD. Keep the
# sponsor wallets small and dedicated: if one is ever abused, rotate it
# without touching anything else. See docs/try-it-demo-plan.md.

# Midnight preprod endpoints + the CURRENT 0.10.0 vault (registerPassport
# capable, deployed 2026-07-24 by the Main wallet = registrar).
NIGHTGATE_NETWORK=preprod
NIGHTGATE_INDEXER_HTTP_URL=https://indexer.preprod.midnight.network/api/v4/graphql
NIGHTGATE_NODE_URL=wss://rpc.preprod.midnight.network
PASSPORT_CONTRACT_ADDRESS=56d60a2fa27026ac60ed3381c5c84a2076bf06022b3f3a9675cc40b2e237b483

# Proof server inside the compose network (service name, never the host).
NIGHTGATE_PROOF_SERVER_URL=http://proof-server:6300

# Payload encryption key (demo instance encrypts its own visitor passports;
# a fresh strong value is fine, it does NOT need to match the main instance).
