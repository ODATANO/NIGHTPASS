# "Try it" demo instance config. Copy to deploy/.env.demo and fill in.
# REMOTE transport (default since 2026-08-28): this container holds NO wallet
# and NO NIGHT. Every visitor run builds and proves its transactions here and
# hands them to the hosted NIGHTGATE under an agent grant; the hosted sponsor
# pool pays the dust. See deploy/README.md, "Try-it demo instance".

# Midnight preprod endpoints + the vault the demo anchors on (0.21.7 vault,
# deployed 2026-08-28 by the Main wallet = registrar).
NIGHTGATE_NETWORK=preprod
NIGHTGATE_INDEXER_HTTP_URL=https://indexer.preprod.midnight.network/api/v4/graphql
NIGHTGATE_NODE_URL=wss://rpc.preprod.midnight.network
PASSPORT_CONTRACT_ADDRESS=4a8893cf92b21c32d7b438b7bffdb79d0385fab7e4ac78c249d612637d47c1a4
# Vault POOL for visitor runs (comma list; the first is the default). Every
# vault has ONE attestation-sequence cell, so two attests in the same block on
# one vault collide; runs are spread over the pool (fewest in flight first).
# All of them must be in the hosted sponsor policy and in the agent grant.
PASSPORT_CONTRACT_ADDRESSES=4a8893cf92b21c32d7b438b7bffdb79d0385fab7e4ac78c249d612637d47c1a4,ff34580b333f3f7761277f9a7aa646dadd261a1afadb6cb683406dcc20decbc6,7083f7452ee69c8726dd172152b59d2b8b2dd6c5ba6fa09ffba8193ea0547a65,62dd5c555904ee2eab733f189e874182cd4c23bf5ab671f1ca0fb877f3e80b03

# ---------------------------------------------------------------------------
# Remote transport: hosted NIGHTGATE + agent grant.
# ---------------------------------------------------------------------------
DEMO_TRANSPORT=remote
NIGHTGATE_API_URL=https://api.nightgate.dev
# Agent grant token (ngat_...), shown once by createAgentGrant on the hosted
# side. Spend authority within the grant's policy: keep it out of git and logs.
DEMO_NIGHTGATE_AGENT_TOKEN=
# Proving: our own proof server inside the compose network (it receives the
# witnesses, so never the hosted one). Leave empty to prove in-process (wasm).
NIGHTGATE_PROOF_SERVER_URL=http://proof-server:6300
# Verification reads: hosted (token) or plugin (in-process). Unset = hosted
# on the remote transport.
# NIGHTGATE_VERIFY_VIA=hosted
# Ownership pre-registration needs the registrar's key in this container;
# off in phase 1 of the remote demo.
DEMO_REGISTER_OWNERSHIP=false

# Payload encryption key (payload cipher + tester seeds at rest). A fresh
# strong 64-hex value; it does NOT need to match the main instance.
ENCRYPTION_KEY=

# Demo surface + service switches. 'demo,explorer' serves the demo AND this
# instance's own passport explorer (the done view links /explorer/#/p/<id>
# with live on-chain verification).
DEMO_ENABLED=true
PASSPORT_PUBLIC_SURFACE=demo,explorer
# Behind Caddy: resolve the visitor IP from X-Forwarded-For, otherwise every
# visitor shares one per-IP cap bucket.
PASSPORT_TRUST_PROXY=true
# Parallel runs; proving capacity is the bound on the remote transport.
DEMO_CONCURRENCY=3
# DEMO_MAX_PER_DAY=50
# DEMO_MAX_PER_IP_PER_DAY=5
# Comma list of IPs exempt from the per-IP cap (maintainer smoke tests).
# DEMO_IP_ALLOWLIST=
# DEMO_MAX_PER_TESTER=1
# DEMO_MAX_QUEUE=5

# Publishing to zkpassport.eu is OFF for the preprod demo: that explorer is a
# PREVIEW instance, and this host serves its own preprod explorer instead.
PASSPORT_PUBLISH_URL=

# Shown in QR urls of demo passports (the demo host itself).
PASSPORT_DEMO_HOST=https://zkpassport.eu

# Park the demo behind a static "update in progress" page; flip back to
# false to reopen. No redeploy.
DEMO_MAINTENANCE=false

# ---------------------------------------------------------------------------
# Plugin transport (fallback): DEMO_TRANSPORT=plugin, in-process wallets.
# Only then are the keys below read. mem_limit 12g in docker-compose.yml.
# ---------------------------------------------------------------------------
# The dedicated DEMO SPONSOR POOL (registry wallets S1..S3); one sponsor is
# leased per concurrent run. Values from secrets/producer-wallets.env.
# PRODUCER_WALLETS=S1,S2,S3
# PRODUCER_S1_WALLET_MNEMONIC=
# PRODUCER_S1_VIEWING_KEY=
# PRODUCER_S1_SHIELDED_ADDRESS=
# PRODUCER_S1_LABEL=Demo sponsor 1
# (S2, S3 alike)
# REGISTRAR (ownership pre-registration): the wallet that DEPLOYED the vault.
# The viewing key MUST be the account-0 encryptionPublicKey deriveWalletInfo
# returns for the mnemonic (fail-closed since 0.10.1).
# PRODUCER_WALLET_MNEMONIC=
# PRODUCER_VIEWING_KEY=
# PASSPORT_REGISTRAR_WALLET=default
# PASSPORT_FEE_SPONSOR_WALLET=S1,S2,S3,default
# NIGHTGATE_SPONSORED_CALLER_SYNC=skip
# NIGHTGATE_SIGNING_KEY_RATE_LIMIT=1000
# DEMO_SPONSOR_WATCHDOG_MS=300000
# cds_requires_db_pool_max=20
# cds_requires_db_pool_acquireTimeoutMillis=10000
# NIGHTGATE_WALLET_READ_SYNC_TIMEOUT_MS=2000
