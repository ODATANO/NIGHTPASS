# "Try it" demo instance config. Copy to deploy/.env.demo and fill in.
# This container holds NO wallet and NO NIGHT. Every visitor run (battery or
# component passport) builds and proves its transactions here and hands them
# to the NIGHTGATE API under an agent grant; the API's sponsor pool pays the
# dust. See deploy/README.md, "Try-it demo instance".

# Midnight network and the vault the demo anchors on.
NIGHTGATE_NETWORK=preprod
PASSPORT_CONTRACT_ADDRESS=
# Vault POOL for visitor runs (comma list; the first is the default). The pool
# spreads the load (fewest in flight first). All of them must be in the
# sponsor policy of the API and in the agent grant.
PASSPORT_CONTRACT_ADDRESSES=

# ---------------------------------------------------------------------------
# NIGHTGATE API + agent grant.
# ---------------------------------------------------------------------------
NIGHTGATE_API_URL=https://api.nightgate.dev
# Agent grant token (ngat_...), shown once by createAgentGrant. Spend authority
# within the grant's policy: keep it out of git and logs. An oda_ gateway key
# works here too.
NIGHTGATE_AGENT_TOKEN=
# Proving: our own proof server inside the compose network (it receives the
# witnesses, so never a foreign one). Leave empty to prove in-process (wasm).
NIGHTGATE_PROOF_SERVER_URL=http://proof-server:6300
# Ownership pre-registration needs the registrar wallet's mnemonic in this
# container (PRODUCER_WALLET_MNEMONIC, PASSPORT_REGISTRAR_WALLET).
DEMO_REGISTER_OWNERSHIP=false

# Payload encryption key (payload cipher + tester seeds at rest). A fresh
# strong 64-hex value.
ENCRYPTION_KEY=

# Demo surface + service switches. 'demo,explorer' serves the demo AND this
# instance's own passport explorer (the done view links /explorer/#/p/<id>
# with live on-chain verification).
DEMO_ENABLED=true
PASSPORT_PUBLIC_SURFACE=demo,explorer
# Behind Caddy: resolve the visitor IP from X-Forwarded-For, otherwise every
# visitor shares one per-IP cap bucket.
PASSPORT_TRUST_PROXY=true
# Parallel runs; each run builds in its own worker thread, the shared proof
# server is the bound.
DEMO_CONCURRENCY=3
# DEMO_MAX_PER_DAY=50
# DEMO_MAX_PER_IP_PER_DAY=5
# Comma list of IPs exempt from the per-IP cap (maintainer smoke tests).
# DEMO_IP_ALLOWLIST=
# DEMO_MAX_PER_TESTER=1
# DEMO_MAX_QUEUE=5

# Publishing stays off: this instance serves its own explorer.
PASSPORT_PUBLISH_URL=

# "Try it live" button in the explorer header.
PASSPORT_DEMO_LINK=/demo/

# Shown in QR urls of demo passports (the demo host itself).
PASSPORT_DEMO_HOST=https://zkpassport.eu

# Park the demo behind a static "update in progress" page; flip back to
# false to reopen. No redeploy.
DEMO_MAINTENANCE=false
