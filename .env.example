# NIGHTPASS env template. Copy to .env (gitignored) and fill in.

# 32-byte hex AES key for the off-chain payload cipher (dev tolerates a default).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Midnight network. The ws indexer URL is derived from the HTTP URL (NIGHTGATE 0.7.1).
# The preview testnet was reset 2026-07-16 and is deliberately abandoned; use preprod.
NIGHTGATE_NETWORK=preprod
NIGHTGATE_NODE_URL=wss://rpc.preprod.midnight.network/
NIGHTGATE_INDEXER_HTTP_URL=https://indexer.preprod.midnight.network/api/v4/graphql
NIGHTGATE_CRAWLER_ENABLED=false

# Deployed attestation vault. Must match the network:
# preprod=da9b0bcf1a2d8a6c52664f3f773ea0076e02ed2a7c13019f8b9d9f75952b0812
PASSPORT_CONTRACT_ADDRESS=

# Wallet secrets, only needed for live on-chain anchoring. NEVER commit real values.
LACE_MNEMONIC=
LACE_VIEWING_KEY=

# Legacy single server wallet (cockpit id "default", used by the ERP ingest path).
# Multi-wallet setup: npm run start:wallets loads secrets/producer-wallets.env.
PRODUCER_WALLET_MNEMONIC=
# NOTE: with NODE_ENV=production CAP does NOT read this file. Pass the vars as
# real environment variables there (compose `env_file:` does exactly that);
# otherwise the boot guard refuses to start for a missing ENCRYPTION_KEY.
PRODUCER_VIEWING_KEY=

# Operator handover (Second Life): the registrar wallet that re-registers a
# passport id to a new operator's attester identity. MUST be the wallet that
# deployed the vault (constructor locks its attester id in as registrar);
# for the current preprod vault that is Main = 'default'.
# PASSPORT_REGISTRAR_WALLET=default
# Optional per-wallet attester-id cache (deriveWalletInfo.attesterId, 64 hex).
# Saves the rate-limited derive call on the first handover to that wallet.
# PRODUCER_A_ATTESTER_ID=

# Optional per-tx fee sponsoring (NIGHTGATE 0.8.0): the named server wallet
# (a registry id, e.g. "default") pays the dust fees for every other wallet's
# on-chain legs (anchor, disclosure, predicate proofs). Producer wallets then
# need neither NIGHT nor dust. Unset = every wallet pays its own fees.
# PASSPORT_FEE_SPONSOR_WALLET=default

# BMS telemetry ingest (POST /api/v1/passport/telemetry): HMAC shared secret
# for dynamic SoH attribute updates. Unset = endpoint answers 503. The ERP
# webhook (ERP_WEBHOOK_SECRET) uses the same pattern for goods receipts.
# TELEMETRY_WEBHOOK_SECRET=

# Public deploy options (demo user passwords, explorer federation, verify peers,
# PASSPORT_PUBLIC_SURFACE, PASSPORT_DEMO_HOST): see docs/public-demo.md
# Host-owned browser security. Cross-origin access is disabled by default;
# list trusted wallet/front-end origins as a comma-separated allow-list.
# PASSPORT_CORS_ORIGINS=https://wallet.example,https://app.example
# PASSPORT_CORS_API=true
# PASSPORT_CONTENT_SECURITY_POLICY=off
# PASSPORT_HSTS=max-age=31536000

# NIGHTGATE currently guarantees one process and one tenant only. Set this to
# the real process/replica count; values above 1 intentionally fail closed.
NIGHTGATE_REPLICA_COUNT=1

# Production only: NIGHTPASS selects PostgreSQL through its CAP production
# profile. Inject credentials as a service binding; Docker Compose does this
# from deploy/.env. SQLite remains the local development/test database.
