# NIGHTPASS env template. Copy to .env (gitignored) and fill in.

# 32-byte hex AES key for the off-chain payload cipher (dev tolerates a default).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Midnight network and the NIGHTGATE API this server works against. The API
# reads the chain, pays the fees and submits; keys and proving stay here.
NIGHTGATE_NETWORK=preprod
NIGHTGATE_API_URL=https://api.nightgate.dev
# Agent grant token (ngat_...) or gateway key (oda_...). Spend authority
# within the grant's policy: keep it out of git and logs. Without it the
# server works offline (hash, encrypt, persist) and verifies on chain.
NIGHTGATE_AGENT_TOKEN=
# Own proof server (it receives the witnesses). Empty = prove in-process (wasm).
# NIGHTGATE_PROOF_SERVER_URL=http://localhost:6300
# Indexer the browser wallet flow is pointed at (default: the network's public one).
# NIGHTGATE_INDEXER_HTTP_URL=

# Deployed attestation vault on that network. It must be in the sponsor
# policy of the API and in the grant.
PASSPORT_CONTRACT_ADDRESS=

# Server wallet (cockpit id "default", used by the ERP ingest path): its
# mnemonic signs here and never leaves this server. NEVER commit a real value.
# Multi-wallet setup: npm run start:wallets loads secrets/producer-wallets.env.
# NOTE: with NODE_ENV=production CAP does NOT read this file. Pass the vars as
# real environment variables there (compose `env_file:` does exactly that);
# otherwise the boot guard refuses to start for a missing ENCRYPTION_KEY.
PRODUCER_WALLET_MNEMONIC=

# Operator handover (Second Life): the registrar wallet that re-registers a
# passport id to a new operator's attester identity. MUST be the wallet whose
# attester id the vault names as registrar.
# PASSPORT_REGISTRAR_WALLET=default

# Lifetime of a new ZK claim in seconds (every claim carries an expiry, at
# most five years; an expired claim verifies false until it is proven again).
# Default: the five-year cap less a day.
# PASSPORT_CLAIM_LIFETIME_S=157593600
# Optional per-wallet attester id (64 hex); unset = derived from the mnemonic.
# PRODUCER_A_ATTESTER_ID=

# BMS telemetry ingest (POST /api/v1/passport/telemetry, battery family): HMAC
# shared secret for dynamic SoH attribute updates. Unset = endpoint answers 503.
# The ERP webhook (ERP_WEBHOOK_SECRET) uses the same pattern for goods receipts.
# TELEMETRY_WEBHOOK_SECRET=

# Public deploy options (demo user passwords, explorer federation, verify peers,
# PASSPORT_PUBLIC_SURFACE, PASSPORT_DEMO_HOST): see docs/public-demo.md
# Host-owned browser security. Cross-origin access is disabled by default;
# list trusted wallet/front-end origins as a comma-separated allow-list.
# PASSPORT_CORS_ORIGINS=https://wallet.example,https://app.example
# PASSPORT_CORS_API=true
# PASSPORT_CONTENT_SECURITY_POLICY=off
# PASSPORT_HSTS=max-age=31536000

# Production only: NIGHTPASS selects PostgreSQL through its CAP production
# profile. Inject credentials as a service binding; Docker Compose does this
# from deploy/.env. SQLite remains the local development/test database.
